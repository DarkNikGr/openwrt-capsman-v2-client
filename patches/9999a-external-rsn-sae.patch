+/*
+ * EXT_AUTH_MGMT_TX <mgmt-frame-hex>
+ *
+ * Transmit a management frame built by the external RSN authenticator (the
+ * CAPsMAN manager's 0x2019).  In a split-MAC CAP the manager is the SAE
+ * authenticator, so its Authentication responses (SAE commit/confirm) must
+ * go on air through hostapd's normal management TX path (driver sequence
+ * numbers, ACK/retry bookkeeping).  The frame already carries DA/SA/BSSID;
+ * the BSSID/SA are forced to the hostapd BSS address so a manager-side VAP
+ * MAC mismatch cannot send a frame with a foreign BSSID.
+ */
+static int hostapd_ctrl_iface_ext_auth_mgmt_tx(struct hostapd_data *hapd,
+					       char *cmd)
+{
+	u8 *buf;
+	size_t len;
+	int ret;
+
+	/* cmd may still carry the client's trailing newline */
+	while (*cmd && (cmd[os_strlen(cmd) - 1] == '\n' ||
+			cmd[os_strlen(cmd) - 1] == '\r' ||
+			cmd[os_strlen(cmd) - 1] == ' '))
+		cmd[os_strlen(cmd) - 1] = '\0';
+
+	len = os_strlen(cmd);
+	if (!len || (len & 1))
+		return -1;
+	len /= 2;
+	if (len < IEEE80211_HDRLEN || len > 4096)
+		return -1;
+
+	buf = os_malloc(len);
+	if (!buf)
+		return -1;
+	if (hexstr2bin(cmd, buf, len) < 0) {
+		os_free(buf);
+		return -1;
+	}
+
+	if (!ether_addr_equal(buf + 10, hapd->own_addr)) {
+		wpa_printf(MSG_DEBUG,
+			   "EXT-AUTH: mgmt TX rewriting addr2 " MACSTR
+			   " -> " MACSTR,
+			   MAC2STR(buf + 10), MAC2STR(hapd->own_addr));
+		os_memcpy(buf + 10, hapd->own_addr, ETH_ALEN);
+		if (len >= 24)
+			os_memcpy(buf + 16, hapd->own_addr, ETH_ALEN);
+	}
+
+	wpa_hexdump(MSG_DEBUG, "EXT-AUTH: mgmt TX", buf, len);
+	ret = hostapd_drv_send_mlme(hapd, buf, len, 0, NULL, 0, 0);
+	wpa_printf(MSG_DEBUG, "EXT-AUTH: mgmt TX subtype=%u len=%lu ret=%d",
+		   (unsigned int) ((buf[0] >> 4) & 0xf),
+		   (unsigned long) len, ret);
+	os_free(buf);
+	return ret;
+}
 #endif /* CONFIG_EXTERNAL_RSN_AUTH */
 
 

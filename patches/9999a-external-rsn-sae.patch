diff --git a/src/ap/ext_auth.c b/src/ap/ext_auth.c
index 8c6e0f7..fc6411c 100644
--- a/src/ap/ext_auth.c
+++ b/src/ap/ext_auth.c
@@ -158,6 +158,54 @@ void ext_auth_notify_eapol(struct hostapd_data *hapd, const u8 *src,
 	ext_auth_send(hapd, buf, n);
 }
 
+/*
+ * SAE/OWE and (Re)Association frames are 802.11 management frames, not
+ * EAPOL.  A split-MAC CAP must relay the raw frame to the manager; the
+ * manager owns the SAE state machine and builds the Peer from the raw
+ * Association Request.  Reusing the same text protocol keeps one socket per
+ * BSS: "AUTH <mac> <hex>" and "ASSOCREQ <mac> <hex>".
+ */
+static void ext_auth_notify_mgmt(struct hostapd_data *hapd, const char *tag,
+				 const u8 *src, const u8 *data, size_t len)
+{
+	char buf[EXT_AUTH_MSG_MAX];
+	int n;
+
+	if (!hapd->ext_auth)
+		return;
+
+	if (2 * len + 64 > sizeof(buf)) {
+		wpa_printf(MSG_INFO,
+			   "EXT-AUTH: dropping oversized %s frame (%lu bytes)",
+			   tag, (unsigned long) len);
+		return;
+	}
+
+	n = os_snprintf(buf, sizeof(buf), "%s " MACSTR " ", tag, MAC2STR(src));
+	if (os_snprintf_error(sizeof(buf), n))
+		return;
+
+	n += wpa_snprintf_hex(buf + n, sizeof(buf) - n, data, len);
+	buf[n++] = '\n';
+
+	wpa_hexdump(MSG_DEBUG, tag, data, len);
+	wpa_printf(MSG_DEBUG, "EXT-AUTH: relaying %s from " MACSTR
+		   " (%lu bytes)", tag, MAC2STR(src), (unsigned long) len);
+	ext_auth_send(hapd, buf, n);
+}
+
+void ext_auth_notify_auth(struct hostapd_data *hapd, const u8 *src,
+			  const u8 *data, size_t len)
+{
+	ext_auth_notify_mgmt(hapd, "AUTH", src, data, len);
+}
+
+void ext_auth_notify_assocreq(struct hostapd_data *hapd, const u8 *src,
+			      const u8 *data, size_t len)
+{
+	ext_auth_notify_mgmt(hapd, "ASSOCREQ", src, data, len);
+}
+

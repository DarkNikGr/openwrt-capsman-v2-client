+/*
+ * EXT_AUTH_TX <sta-mac> <eapol-hex> [encrypt=1]
+ *
+ * Send an EAPOL frame generated by the external RSN authenticator (e.g., an
+ * M1/M3 produced by the CAPsMAN manager) to a station through the normal
+ * hostapd driver path.  encrypt=0 (the default) is what an unassociated or
+ * not-yet-authorized station expects for the 4-way handshake.
+ */
+static int hostapd_ctrl_iface_ext_auth_tx(struct hostapd_data *hapd, char *cmd)
+{
+	char *pos, *pos2;
+	u8 dst[ETH_ALEN], *buf;
+	int used, ret;
+	size_t len;
+	int encrypt = 0;
+
+	pos = cmd;
+	used = hwaddr_aton2(pos, dst);
+	if (used < 0)
+		return -1;
+	pos += used;
+	while (*pos == ' ')
+		pos++;
+
+	pos2 = os_strchr(pos, ' ');
+	if (pos2) {
+		len = pos2 - pos;
+		encrypt = os_strstr(pos2, "encrypt=1") != NULL;
+	} else {
+		len = os_strlen(pos);
+	}
+	if (len & 1)
+		return -1;
+	len /= 2;
+	if (!len)
+		return -1;
+
+	buf = os_malloc(len);
+	if (!buf)
+		return -1;
+	if (hexstr2bin(pos, buf, len) < 0) {
+		os_free(buf);
+		return -1;
+	}
+
+	wpa_printf(MSG_DEBUG, "EXT-AUTH: TX " MACSTR " len=%lu encrypt=%d",
+		   MAC2STR(dst), (unsigned long) len, encrypt);
+	ret = hostapd_wpa_auth_send_eapol(hapd, dst, buf, len, encrypt);
+	os_free(buf);
+
+	return ret;
+}
+#endif /* CONFIG_EXTERNAL_RSN_AUTH */

diff --git a/src/ap/ext_auth.c b/src/ap/ext_auth.c
new file mode 100644
index 0000000..8c6e0f7
--- /dev/null
+++ b/src/ap/ext_auth.c
@@ -0,0 +1,207 @@
+/*
+ * hostapd / External RSN authenticator relay
+ * Copyright (c) 2026
+ *
+ * This software may be distributed under the terms of the BSD license.
+ * See README for more details.
+ */
+
+#include "utils/includes.h"
+#include <sys/un.h>
+
+#include "utils/common.h"
+#include "hostapd.h"
+#include "sta_info.h"
+#include "wpa_auth.h"
+#include "ieee802_1x.h"
+#include "ext_auth.h"
+
+#define EXT_AUTH_DEFAULT_PREFIX "/var/run/hostapd/ext-auth-"
+#define EXT_AUTH_MSG_MAX 4096
+
+struct ext_auth_data {
+	int fd;
+	struct sockaddr_un addr;
+	socklen_t addr_len;
+};
+
+static int ext_auth_send(struct hostapd_data *hapd, const char *buf, size_t len)
+{
+	struct ext_auth_data *ctx = hapd->ext_auth;
+
+	if (!ctx)
+		return -1;
+
+	if (sendto(ctx->fd, buf, len, 0, (struct sockaddr *) &ctx->addr,
+		   ctx->addr_len) < 0) {
+		/*
+		 * ENOENT/ECONNREFUSED simply means that the external
+		 * authenticator is not (yet) running; keep the BSS usable.
+		 */
+		wpa_printf(MSG_DEBUG,
+			   "EXT-AUTH: %s: sendto failed: %s",
+			   hapd->conf->iface, strerror(errno));
+		return -1;
+	}
+
+	return 0;
+}
+
+int ext_auth_init(struct hostapd_data *hapd)
+{
+	struct ext_auth_data *ctx;
+	const char *path = hapd->conf->ext_auth_socket;
+	char def[128];
+
+	if (!hapd->conf->external_rsn_auth)
+		return 0;
+
+	if (!path || !path[0]) {
+		os_snprintf(def, sizeof(def), EXT_AUTH_DEFAULT_PREFIX "%s",
+			    hapd->conf->iface);
+		path = def;
+	}
+
+	if (os_strlen(path) >= sizeof(hapd->ext_auth->addr.sun_path)) {
+		wpa_printf(MSG_ERROR, "EXT-AUTH: socket path too long: %s",
+			   path);
+		return -1;
+	}
+
+	ctx = os_zalloc(sizeof(*ctx));
+	if (!ctx)
+		return -1;
+
+	ctx->fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+	if (ctx->fd < 0) {
+		wpa_printf(MSG_ERROR, "EXT-AUTH: socket: %s", strerror(errno));
+		os_free(ctx);
+		return -1;
+	}
+
+	ctx->addr.sun_family = AF_UNIX;
+	os_strlcpy(ctx->addr.sun_path, path, sizeof(ctx->addr.sun_path));
+	ctx->addr_len = offsetof(struct sockaddr_un, sun_path) +
+		os_strlen(path) + 1;
+
+	hapd->ext_auth = ctx;
+	wpa_printf(MSG_INFO, "EXT-AUTH: %s: relaying EAPOL to %s",
+		   hapd->conf->iface, path);
+	return 0;
+}
+
+void ext_auth_deinit(struct hostapd_data *hapd)
+{
+	struct ext_auth_data *ctx = hapd->ext_auth;
+
+	if (!ctx)
+		return;
+
+	close(ctx->fd);
+	os_free(ctx);
+	hapd->ext_auth = NULL;
+}
+
+void ext_auth_notify_assoc(struct hostapd_data *hapd, struct sta_info *sta)
+{
+	char buf[1024];
+	const u8 *ie;
+	size_t ie_len = 0;
+	int len;
+
+	if (!hapd->ext_auth)
+		return;
+
+	ie = wpa_auth_get_wpa_ie(hapd->wpa_auth, &ie_len);
+
+	len = os_snprintf(buf, sizeof(buf), "ASSOC " MACSTR " ",
+			  MAC2STR(sta->addr));
+	if (os_snprintf_error(sizeof(buf), len))
+		return;
+
+	if (ie && ie_len && 2 * ie_len + 2 < sizeof(buf) - (size_t) len)
+		len += wpa_snprintf_hex(buf + len, sizeof(buf) - len, ie,
+					ie_len);
+	else
+		len += os_snprintf(buf + len, sizeof(buf) - len, "-");
+	if (os_snprintf_error(sizeof(buf), len))
+		return;
+
+	buf[len++] = '\n';
+	ext_auth_send(hapd, buf, len);
+}
+
+void ext_auth_notify_eapol(struct hostapd_data *hapd, const u8 *src,
+			   const u8 *data, size_t len, int encrypted)
+{
+	char buf[EXT_AUTH_MSG_MAX];
+	int n;
+
+	if (!hapd->ext_auth)
+		return;
+
+	if (2 * len + 64 > sizeof(buf)) {
+		wpa_printf(MSG_INFO,
+			   "EXT-AUTH: dropping oversized EAPOL frame (%lu bytes)",
+			   (unsigned long) len);
+		return;
+	}
+
+	n = os_snprintf(buf, sizeof(buf), "EAPOL " MACSTR " %d ",
+			MAC2STR(src), encrypted ? 1 : 0);
+	if (os_snprintf_error(sizeof(buf), n))
+		return;
+
+	n += wpa_snprintf_hex(buf + n, sizeof(buf) - n, data, len);
+	buf[n++] = '\n';
+
+	ext_auth_send(hapd, buf, n);
+}
+
+void ext_auth_notify_disconnect(struct hostapd_data *hapd,
+				struct sta_info *sta)
+{
+	char buf[64];
+	int len;
+
+	if (!hapd->ext_auth)
+		return;
+
+	len = os_snprintf(buf, sizeof(buf), "DISCONNECT " MACSTR "\n",
+			  MAC2STR(sta->addr));
+	if (os_snprintf_error(sizeof(buf), len))
+		return;
+
+	ext_auth_send(hapd, buf, len);
+}
+
+int ext_auth_authorize(struct hostapd_data *hapd, const u8 *addr)
+{
+	struct sta_info *sta = ap_get_sta(hapd, addr);
+
+	if (!hapd->ext_auth)
+		return -1;
+	if (!sta) {
+		wpa_printf(MSG_INFO,
+			   "EXT-AUTH: authorize: unknown station " MACSTR,
+			   MAC2STR(addr));
+		return -1;
+	}
+	if (!(sta->flags & WLAN_STA_ASSOC)) {
+		wpa_printf(MSG_INFO,
+			   "EXT-AUTH: authorize: station " MACSTR
+			   " is not associated", MAC2STR(addr));
+		return -1;
+	}
+
+	/*
+	 * This mirrors the normal IEEE 802.1X success path: driver station
+	 * flags (AUTHORIZED), hostapd station state, accounting and the
+	 * AP-STA-CONNECTED event.
+	 */
+	ieee802_1x_external_rsn_set_authorized(hapd, sta, 1);
+	wpa_printf(MSG_INFO,
+		   "EXT-AUTH: station " MACSTR " authorized by external authenticator",
+		   MAC2STR(addr));
+	return 0;
+}
diff --git a/src/ap/ext_auth.h b/src/ap/ext_auth.h
new file mode 100644
index 0000000..7aac349
--- /dev/null
+++ b/src/ap/ext_auth.h
@@ -0,0 +1,96 @@
+/*
+ * hostapd / External RSN authenticator relay
+ * Copyright (c) 2026
+ *
+ * This software may be distributed under the terms of the BSD license.
+ * See README for more details.
+ *
+ * When external_rsn_auth=1 is set for a BSS, hostapd keeps doing everything it
+ * normally does for an AP (beaconing, authentication, association, RSN IE,
+ * AP-VLAN, ...) except the RSN 4-way handshake:
+ *
+ *  - hostapd_new_assoc_sta() does not start the local WPA/IEEE 802.1X state
+ *    machine, so no M1 is generated locally;
+ *  - every EAPOL frame received on the cfg80211 control port is relayed to an
+ *    external process (the "authenticator") instead of being passed to
+ *    ieee802_1x_receive()/wpa_receive().
+ *
+ * The relay uses a UNIX SOCK_DGRAM socket whose path is configured with
+ * ext_auth_socket=<path> (default /var/run/hostapd/ext-auth-<ifname>).  The
+ * external process binds that path; hostapd only sends to it.  One datagram is
+ * one newline-terminated text message:
+ *
+ *   ASSOC <sta-mac> <rsn-ie-hex|->      station associated (RSN IE of the BSS)
+ *   EAPOL <sta-mac> <0|1> <eapol-hex>   0 = not encrypted, 1 = encrypted
+ *   DISCONNECT <sta-mac>                station entry removed
+ *
+ * The reverse direction (frame TX, authorization, deauth) intentionally uses
+ * the existing hostapd control interface, which is already a root-only UNIX
+ * socket:
+ *
+ *   EXT_AUTH_TX <sta-mac> <eapol-hex> [encrypt=1]
+ *   EXT_AUTH_AUTHORIZE <sta-mac>
+ *   DEAUTHENTICATE <sta-mac> <reason>   (existing command)
+ *   DISASSOCIATE <sta-mac> <reason>     (existing command)
+ *
+ * The external authenticator is expected to install the PTK/GTK with nl80211
+ * (NL80211_CMD_NEW_KEY / SET_KEY) and to authorize the station with
+ * NL80211_CMD_SET_STATION + NL80211_STA_FLAG_AUTHORIZED; EXT_AUTH_AUTHORIZE
+ * then makes hostapd's own station state, accounting and AP-STA-CONNECTED
+ * event follow.
+ */
+
+#ifndef EXT_AUTH_H
+#define EXT_AUTH_H
+
+#include "common/defs.h"
+
+struct hostapd_data;
+struct sta_info;
+
+#ifdef CONFIG_EXTERNAL_RSN_AUTH
+
+int ext_auth_init(struct hostapd_data *hapd);
+void ext_auth_deinit(struct hostapd_data *hapd);
+void ext_auth_notify_assoc(struct hostapd_data *hapd, struct sta_info *sta);
+void ext_auth_notify_eapol(struct hostapd_data *hapd, const u8 *src,
+			   const u8 *data, size_t len, int encrypted);
+void ext_auth_notify_disconnect(struct hostapd_data *hapd, struct sta_info *sta);
+int ext_auth_authorize(struct hostapd_data *hapd, const u8 *addr);
+
+#else /* CONFIG_EXTERNAL_RSN_AUTH */
+
+static inline int ext_auth_init(struct hostapd_data *hapd)
+{
+	return 0;
+}
+
+static inline void ext_auth_deinit(struct hostapd_data *hapd)
+{
+}
+
+static inline void ext_auth_notify_assoc(struct hostapd_data *hapd,
+					 struct sta_info *sta)
+{
+}
+
+static inline void ext_auth_notify_eapol(struct hostapd_data *hapd,
+					 const u8 *src, const u8 *data,
+					 size_t len, int encrypted)
+{
+}
+
+static inline void ext_auth_notify_disconnect(struct hostapd_data *hapd,
+					      struct sta_info *sta)
+{
+}
+
+static inline int ext_auth_authorize(struct hostapd_data *hapd,
+				     const u8 *addr)
+{
+	return -1;
+}
+
+#endif /* CONFIG_EXTERNAL_RSN_AUTH */
+
+#endif /* EXT_AUTH_H */

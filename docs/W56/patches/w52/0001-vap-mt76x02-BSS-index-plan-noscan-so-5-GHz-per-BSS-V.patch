-        if (g_vmap[r][i].used && !memcmp(g_vmap[r][i].mac, mac, 6))
+        if (g_vmap[r][i].used &&
+            (!memcmp(g_vmap[r][i].mac, mac, 6) ||
+             !memcmp(g_vmap[r][i].bssid, mac, 6))) {

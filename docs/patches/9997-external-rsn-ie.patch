diff --git a/hostapd/hostapd.conf b/hostapd/hostapd.conf
index 55657ae..fdc4828 100644
--- a/hostapd/hostapd.conf
+++ b/hostapd/hostapd.conf
@@ -1871,6 +1871,20 @@ own_ip_addr=127.0.0.1
 # /var/run/hostapd/ext-auth-<ifname>.
 #ext_auth_socket=/var/run/hostapd/ext-auth-wlan0
 
+# Exact RSN IE to advertise in Beacon, Probe Response and (Re)Association
+# Response frames.  The value is a hex dump of the complete RSN element,
+# including the element ID (0x30) and the length octet.  When set, hostapd
+# emits these bytes verbatim instead of generating an RSN IE from
+# wpa/rsn_pairwise/wpa_key_mgmt/ieee80211w, and it does not append an RSNXE.
+#
+# This is needed with an external RSN authenticator that lives in a CAPsMAN
+# manager: the station compares the RSN IE in the 3/4 message with the one in
+# Beacon/Probe Response and rejects M3 unless they are identical.  Use the RSN
+# IE from the manager's provisioning message (0x6016, element 0x04) here.
+# The string must be even-length; the element ID must be 0x30 and the length
+# octet must match the remaining size.  Example (28 bytes):
+#external_rsn_ie=301a0100000fac040100000fac040100000fac0280000000000fac06
+
 # Set of accepted key management algorithms (WPA-PSK, WPA-EAP, or both). The
 # entries are separated with a space. WPA-PSK-SHA256 and WPA-EAP-SHA256 can be
 # added to enable SHA256-based stronger algorithms.
diff --git a/src/ap/ap_config.h b/src/ap/ap_config.h
index 367b939..77e1143 100644
--- a/src/ap/ap_config.h
+++ b/src/ap/ap_config.h
@@ -388,6 +388,15 @@ struct hostapd_bss_config {
 	 */
 	int external_rsn_auth;
 	char *ext_auth_socket; /* UNIX dgram path, default per-ifname */
+	/*
+	 * Exact RSN IE (element ID and length octets included) to advertise in
+	 * Beacon/Probe Response/(Re)Association Response frames instead of the
+	 * locally generated one.  Needed when the RSN authenticator runs in the
+	 * manager: the station compares the RSN IE from the 3/4 message with
+	 * the one from the Beacon/Probe Response and drops M3 on any mismatch.
+	 */
+	u8 external_rsn_ie[257]; /* max element size, cf. MAX_OWN_IE_OVERRIDE */
+	size_t external_rsn_ie_len;
 	int wpa_pairwise;
 	int group_cipher; /* wpa_group value override from configuation */
 	int wpa_group;

 	if (wconf->ssid_len > SSID_MAX_LEN)
diff --git a/src/ap/wpa_auth_ie.c b/src/ap/wpa_auth_ie.c
index 43d9c1d..42d1e2c 100644
--- a/src/ap/wpa_auth_ie.c
+++ b/src/ap/wpa_auth_ie.c
@@ -658,6 +658,32 @@ int wpa_auth_gen_wpa_ie(struct wpa_authenticator *wpa_auth)
 		pos = wpa_write_osen(&wpa_auth->conf, pos);
 	}
 	if (wpa_auth->conf.wpa & WPA_PROTO_RSN) {
+#ifdef CONFIG_EXTERNAL_RSN_AUTH
+		if (wpa_auth->conf.external_rsn_ie_len) {
+			/*
+			 * Use the RSN IE exactly as the external RSN
+			 * authenticator (the CAPsMAN manager) sent it.  The
+			 * station compares this element in the 3/4 message
+			 * against the one from Beacon/Probe Response, so both
+			 * must be the very same bytes, including capabilities
+			 * and any group management cipher suite.
+			 *
+			 * No RSNXE is appended in this mode: the manager's
+			 * element is emitted verbatim.
+			 */
+			wpa_hexdump(MSG_DEBUG,
+				    "RSN: Using external RSNE override",
+				    wpa_auth->conf.external_rsn_ie,
+				    wpa_auth->conf.external_rsn_ie_len);
+			if (sizeof(buf) - (pos - buf) <
+			    wpa_auth->conf.external_rsn_ie_len)
+				return -1;
+			os_memcpy(pos, wpa_auth->conf.external_rsn_ie,
+				  wpa_auth->conf.external_rsn_ie_len);
+			pos += wpa_auth->conf.external_rsn_ie_len;
+			goto rsn_ie_done;
+		}
+#endif /* CONFIG_EXTERNAL_RSN_AUTH */
 #ifdef CONFIG_TESTING_OPTIONS
 		if (wpa_auth->conf.rsne_override_set) {
 			wpa_hexdump(MSG_DEBUG,
@@ -703,6 +729,9 @@ int wpa_auth_gen_wpa_ie(struct wpa_authenticator *wpa_auth)
 			return res;
 		pos += res;
 	}
+#ifdef CONFIG_EXTERNAL_RSN_AUTH
+rsn_ie_done:
+#endif /* CONFIG_EXTERNAL_RSN_AUTH */
 #ifdef CONFIG_TESTING_OPTIONS
 fte:
 #endif /* CONFIG_TESTING_OPTIONS */
